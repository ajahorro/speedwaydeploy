# ============================================================================
# backend/.env  —  SINGLE SOURCE OF TRUTH for backend + Edge Function secrets
# ============================================================================
# Copy this file to backend/.env and fill in real values. backend/.env is
# git-ignored and must NEVER be committed.
#
# The email credentials below are authored HERE and pushed to Supabase secrets
# (which the Edge Functions read) with a single command:
#
#     npm run sync-secrets
#
# That two-store setup is deliberate: the Node backend reads backend/.env at
# runtime, while the Deno Edge Functions read Supabase secrets. This script is
# the bridge, so the two can never drift — the drift that previously made
# send-refund-receipt fail with `{"error":"API key is invalid"}`.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Project URL (Dashboard → Project Settings → API → Project URL)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# service_role key (Dashboard → Project Settings → API → service_role secret).
# Full DB access — never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>

# --- Resend (transactional email) ------------------------------------------
# Create/manage at https://resend.com/api-keys . Keys start with `re_`.
# Must belong to the SAME Resend account that verified the sending domain.
RESEND_API_KEY=re_<your-resend-api-key>
# Verified sending address. The domain here MUST be verified in Resend, or
# every send is rejected. Keep it aligned with the Edge Function fallbacks.
RESEND_FROM=Comar Garage <notifications@speedway-autoxmoto.xyz>
# Backend's alias for the same sender (emailService reads either).
RESEND_SENDER_EMAIL=Comar Garage <notifications@speedway-autoxmoto.xyz>

# --- Google Gemini (receipt OCR) -------------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# --- App --------------------------------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:5173